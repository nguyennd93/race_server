// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"          // KHÔNG còn "prisma-client-js"
  output       = "../src/generated/prisma" // client sinh vào src, không nằm trong node_modules nữa
  moduleFormat = "cjs"                     // QUAN TRỌNG: khớp với NestJS (chạy CommonJS)
}

datasource db {
  provider = "mysql"
}

// ===== USER PROFILE =====
enum Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model User {
  id            String   @id @default(uuid())
  deviceId      String   @unique              // đăng nhập ẩn danh theo thiết bị
  facebookId    String?  @unique              // null cho tới khi link Facebook
  displayName   String   @default("Racer")
  rankScore     Int      @default(1000)
  tier          Tier     @default(BRONZE)
  coin          Int      @default(0)
  region        String   @default("GLOBAL")   // vd: SEA, NA, EU
  equippedCarId String?
  equippedCar   Car?     @relation("Equipped", fields: [equippedCarId], references: [id])

  ownedCars  UserCar[]
  matches    MatchParticipant[]
  purchases  Purchase[]
  rewards    LeaderboardReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region, rankScore])   // tăng tốc xếp hạng leaderboard
}

// ===== XE / EQUIPMENT =====
model Car {
  id        String    @id @default(uuid())
  code      String    @unique         // vd "car_ferrari"
  name      String
  priceCoin Int       @default(0)
  baseSpeed Int       @default(100)

  ownedBy    UserCar[]
  equippedBy User[]    @relation("Equipped")
  createdAt  DateTime  @default(now())
}

model UserCar {                         // bảng nối: user nào sở hữu xe nào
  id        String   @id @default(uuid())
  userId    String
  carId     String
  user      User     @relation(fields: [userId], references: [id])
  car       Car      @relation(fields: [carId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, carId])             // không cho sở hữu trùng 1 xe 2 lần
}

// ===== MATCH HISTORY =====
model Match {
  id           String    @id @default(uuid())
  trackCode    String                    // bản đồ đua
  mode         String    @default("PVP")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  participants MatchParticipant[]

  @@index([startedAt])
}

model MatchParticipant {                 // mỗi người chơi trong 1 trận
  id         String   @id @default(uuid())
  matchId    String
  userId     String
  match      Match    @relation(fields: [matchId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  position   Int                          // về hạng mấy: 1,2,3...
  finishMs   Int?                         // thời gian hoàn thành (ms)
  scoreDelta Int      @default(0)         // điểm rank +/- sau trận
  coinReward Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])            // truy vấn lịch sử của 1 user nhanh
}

// ===== PURCHASE =====
enum Store {
  APPLE
  GOOGLE
}

enum PurchaseStatus {
  PENDING
  VALIDATED
  FAILED
}

model Purchase {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  productId     String                     // vd "coin_pack_500"
  store         Store
  transactionId String?        @unique      // mã giao dịch từ store, chống ghi 2 lần
  receipt       String         @db.Text     // receipt thô để verify
  amountCents   Int            @default(0)
  currency      String         @default("USD")
  coinGranted   Int            @default(0)
  status        PurchaseStatus @default(PENDING)
  validatedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([userId, createdAt])
}

// ===== LEADERBOARD REWARD (lưu lịch sử phát quà mỗi tháng) =====
model LeaderboardReward {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  season     String                         // "2026-06"
  region     String
  rank       Int
  coinReward Int
  claimed    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([userId, season, region])        // mỗi mùa/khu vực chỉ 1 phần thưởng
}