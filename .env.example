# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# ===== Database (RDS MySQL) =====
# host = endpoint RDS (vd race-game-dev-db.xxxx.ap-southeast-1.rds.amazonaws.com)
# user = race_user (tạo trên RDS), DB = race_game (initial database name)
DATABASE_URL="mysql://race_user:change_me_user@<RDS-ENDPOINT>:3306/race_game"

# ===== Auth =====
JWT_SECRET=change_me_long_random      # tạo: openssl rand -base64 48
JWT_EXPIRES_IN=30d

# ===== Ports =====
PORT=3000          # REST API (NestJS)
GAME_PORT=2567     # Colyseus realtime

# ===== Môi trường =====
NODE_ENV=development   # đổi thành production cho prod

# ===== HTTPS (Caddy) — chỉ cần khi chạy kèm docker-compose.caddy.yml =====
REST_DOMAIN=racegame-api.duckdns.org
RT_DOMAIN=racegame-rt.duckdns.org
